{
	"for loop": 
	{
		"prefix": "for",
		"body": 
		[
			"for (var i = 0; i < $1; i += 1)",
			"{",
			"\t$2",
			"}",
			"$3"
		],
		"description": "for loop snippet"
	},
    "while loop": 
	{
		"prefix": "while",
		"body": 
		[
			"while ($1)",
			"{",
			"\t$2",
			"}",
			"$3"
		],
		"description": "while loop snippet"
	},
    "if": 
	{
		"prefix": "if",
		"body": 
		[
			"if ($1)",
			"{",
			"\t$2",
			"}",
			"$3"
		],
		"description": "if snippet"
	},
    "else": 
	{
		"prefix": "else",
		"body": 
		[
			"else",
			"{",
			"\t$1",
			"}",
			"$2"
		],
		"description": "else snippet"
	},
	"class": 
	{
		"prefix": "class",
		"body": 
		[
			"class $1",
			"{",
			"\t$2",
			"}",
			"$3"
		],
		"description": "class snippet"
	},
	"function": 
	{
		"prefix": "fun",
		"body": 
		[
			"fun $1($2)",
			"{",
			"\t$3",
			"}",
			"$4"
		],
		"description": "function snippet"
	},
	"var": 
	{
		"prefix": "var",
		"body": 
		[
			"var $1 = $2;",
			"$3"
		],
		"description": "declare a variable"
	},
	"do while loop":
	{
		"prefix": "do",
		"body":
		[
			"do",
			"{",
			"\t$2",
			"} while ($1);",
			"$3"
		],
		"description": "do while loop snippet"
	},
	"class with superclass":
	{
		"prefix": "classinherit",
		"body":
		[
			"class $1 : $2",
			"{",
			"\t$3",
			"}",
			"$4"
		],
		"description": "class that inherits from another class"
	},
	"initializer":
	{
		"prefix": "init",
		"body":
		[
			"init($1)",
			"{",
			"\t$2",
			"}",
			"$3"
		],
		"description": "class initializer"
	},
	"printf":
	{
		"prefix": "printf",
		"body": "printf(\"{}\\n\", $1);",
		"description": "print a formatted string"
	},
	"array":
	{
		"prefix": "array",
		"body": "var $1 = {$2};",
		"description": "declare an array"
	},
	"slice":
	{
		"prefix": "slice",
		"body": "var $1 = $2[$3 .. $4];",
		"description": "create a slice of an array or a string"
	},
	"import":
	{
		"prefix": "import",
		"body": "import \"$1\";",
		"description": "import a module"
	},
	"named import":
	{
		"prefix": "importfrom",
		"body": "import { $1 } from \"$2\";",
		"description": "import names from a module"
	},
	"export function":
	{
		"prefix": "exportfun",
		"body":
		[
			"export fun $1($2)",
			"{",
			"\t$3",
			"}",
			"$4"
		],
		"description": "export a function"
	},
	"error set":
	{
		"prefix": "error",
		"body": "error $1 { $2 }",
		"description": "declare an error set"
	},
	"throw":
	{
		"prefix": "throw",
		"body": "throw $1.$2;",
		"description": "throw an error"
	},
	"try":
	{
		"prefix": "try",
		"body": "var $1 = try $2;",
		"description": "unwrap a result or propagate the error to the caller"
	},
	"must":
	{
		"prefix": "must",
		"body": "var $1 = must $2;",
		"description": "unwrap a result that is known to be successful"
	},
	"catch":
	{
		"prefix": "catch",
		"body": "var $1 = $2 catch $3;",
		"description": "unwrap a result or fall back to a default value"
	},
	"catch with handler":
	{
		"prefix": "catchhandler",
		"body": "var $1 = $2 catch |${3:err}| $4;",
		"description": "unwrap a result or handle the error"
	},
	"iferror":
	{
		"prefix": "iferror",
		"body":
		[
			"iferror $1 |${2:err}| {",
			"\t$3",
			"} else |${4:value}| {",
			"\t$5",
			"}",
			"$6"
		],
		"description": "branch on the error or the success value of a result"
	},
	"iferror expression":
	{
		"prefix": "iferrorexpr",
		"body": "var $1 = iferror $2 |${3:err}| $4 else |${5:value}| $6;",
		"description": "iferror used as an expression"
	}
}