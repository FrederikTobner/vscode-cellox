{
  "name": "vscode-cellox",
  "displayName": "vscode-cellox",
  "description": "Cellox language support for vscode",
  "version": "0.1.0",
  "publisher": "Frederik-Tobner",
  "icon": "icons/extension_icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrederikTobner/vscode-cellox"
  },
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cellox",
        "aliases": [
          "Cellox"
        ],
        "extensions": [
          ".clx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file_type_cellox.svg",
          "dark": "./icons/file_type_cellox.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "cellox",
        "scopeName": "source.cellox",
        "path": "./syntaxes/cellox.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cellox",
        "path": "./snippets.json"
      }
    ]
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --out vscode-cellox.vsix",
    "install-local": "npm run package && code --install-extension vscode-cellox.vsix --force"
  }
}
