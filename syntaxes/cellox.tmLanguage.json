{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "cellox",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#modules" },
		{ "include": "#error-declaration" },
		{ "include": "#keywords" },
		{ "include": "#statements" },
		{ "include": "#bound-variables" },
		{ "include": "#builtins" },
		{ "include": "#callables" },
		{ "include": "#operators" },
		{ "include": "#properties" },
		{ "include": "#identifiers" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.cellox",
					"match": "//.*$"
				},
				{
					"name": "comment.block.cellox",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{ "include": "#nested-block-comment" }
					]
				}
			]
		},
		"nested-block-comment": {
			"name": "comment.block.cellox",
			"begin": "/\\*",
			"end": "\\*/",
			"patterns": [
				{ "include": "#nested-block-comment" }
			]
		},
		"strings": {
			"name": "string.quoted.double.cellox",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.cellox",
					"match": "\\\\([abfnrtv\"'\\\\?]|[0-7]{1,3}|x[0-9a-fA-F]{1,2})"
				},
				{
					"name": "invalid.illegal.escape.cellox",
					"match": "\\\\."
				},
				{
					"name": "constant.other.placeholder.cellox",
					"match": "\\{\\}"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.cellox",
					"match": "\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.binary.cellox",
					"match": "\\b0[bB][01]+\\b"
				},
				{
					"name": "constant.numeric.decimal.cellox",
					"match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
				}
			]
		},
		"modules": {
			"patterns": [
				{
					"begin": "^\\s*(import)\\b",
					"beginCaptures": {
						"1": { "name": "keyword.control.import.cellox" }
					},
					"end": ";",
					"patterns": [
						{ "include": "#strings" },
						{
							"name": "keyword.control.from.cellox",
							"match": "\\bfrom\\b"
						},
						{
							"name": "variable.other.readwrite.alias.cellox",
							"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
						}
					]
				},
				{
					"match": "^\\s*(export)\\b(?=\\s+(?:var|fun|class)\\b)",
					"captures": {
						"1": { "name": "keyword.control.export.cellox" }
					}
				}
			]
		},
		"error-declaration": {
			"begin": "\\b(error)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
			"beginCaptures": {
				"1": { "name": "storage.type.error.cellox" },
				"2": { "name": "entity.name.type.enum.cellox" },
				"3": { "name": "punctuation.definition.block.cellox" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.definition.block.cellox" }
			},
			"patterns": [
				{ "include": "#comments" },
				{
					"name": "variable.other.enummember.cellox",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.cellox",
					"match": "\\b(if|else|while|do|for|return|break|continue)\\b"
				},
				{
					"name": "keyword.control.exception.cellox",
					"match": "\\b(try|catch|must|iferror|throw)\\b"
				},
				{
					"name": "keyword.operator.logical.cellox",
					"match": "\\b(and|or)\\b"
				},
				{
					"name": "constant.language.null.cellox",
					"match": "\\bnull\\b"
				},
				{
					"name": "constant.language.boolean.cellox",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "variable.language.this.cellox",
					"match": "\\bthis\\b"
				},
				{
					"name": "variable.language.super.cellox",
					"match": "\\bsuper\\b"
				}
			]
		},
		"statements": {
			"patterns": [
				{
					"match": "\\b(var)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
					"captures": {
						"1": { "name": "storage.type.cellox" },
						"2": { "name": "variable.other.readwrite.cellox" }
					}
				},
				{
					"match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^()]*)\\)",
					"captures": {
						"1": { "name": "storage.type.function.cellox" },
						"2": { "name": "entity.name.function.cellox" },
						"3": {
							"patterns": [
								{
									"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
									"name": "variable.parameter.cellox"
								}
							]
						}
					}
				},
				{
					"match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?",
					"captures": {
						"1": { "name": "storage.type.class.cellox" },
						"2": { "name": "entity.name.type.class.cellox" },
						"3": { "name": "storage.modifier.extends.cellox" },
						"4": { "name": "entity.other.inherited-class.cellox" }
					}
				}
			]
		},
		"bound-variables": {
			"match": "(?<!\\|)(\\|)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\|)(?!\\|)",
			"captures": {
				"1": { "name": "punctuation.definition.parameters.cellox" },
				"2": { "name": "variable.parameter.cellox" },
				"3": { "name": "punctuation.definition.parameters.cellox" }
			}
		},
		"builtins": {
			"name": "support.function.builtin.cellox",
			"match": "\\b(append_to_file|array_length|asci_to_num|class_of|clock|cosine|exit|exponential|logarithm|logarithm10|num_to_asci|on_linux|on_macOS|on_windows|printf|random|read_file|read_key|read_line|sine|size_of|string_hash|strlen|string_replace_at|system|tangent|wait|write_to_file)\\b(?=\\s*\\()"
		},
		"callables": {
			"patterns": [
				{
					"match": "\\.\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
					"captures": {
						"1": { "name": "entity.name.function.member.cellox" }
					}
				},
				{
					"name": "entity.name.function.call.cellox",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.range.cellox",
					"match": "\\.\\."
				},
				{
					"name": "keyword.operator.logical.cellox",
					"match": "&&|\\|\\||!(?!=)"
				},
				{
					"name": "keyword.operator.comparison.cellox",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.assignment.cellox",
					"match": "\\*\\*=|\\+=|-=|\\*=|/=|%=|="
				},
				{
					"name": "keyword.operator.arithmetic.cellox",
					"match": "\\*\\*|\\+|-|\\*|/|%"
				}
			]
		},
		"properties": {
			"match": "\\.\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
			"captures": {
				"1": { "name": "variable.other.property.cellox" }
			}
		},
		"identifiers": {
			"name": "variable.other.readwrite.cellox",
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
		}
	},
	"scopeName": "source.cellox"
}
